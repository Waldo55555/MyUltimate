@model IEnumerable<The18th.Areas.Support.SupportDTO.OverheadDescriptionDto>

<table class="table">
    <tr>

        <th>
            @Html.DisplayNameFor(model => model.FullDescription)
        </th>

        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>
                @Html.DisplayFor(modelItem => item.FullDescription)
            </td>
            <td>
                <a class="btn btn-xs btn-primary" href="@item.MoreInfo" target="_blank">More Info</a>
            </td>

        </tr>
    }

</table>
