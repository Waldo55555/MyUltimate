
@{

    ViewBag.Title = "MyDash";
    Layout = "~/Areas/TribalCRM/Views/Shared/_TribalLayoutPage.cshtml";

    //////2nd Level
    HttpCookie currentMemberCookie = Request.Cookies["MemberCookie"];
    var currentMemberNumber = currentMemberCookie["membershipNumber"];

    //Evaluation
    var ourPhoto = The18th.Areas.TribalCRM.Data.TribalEvaluationManager.GetEvaluationProfilePhoto(currentMemberNumber); //accountNumber

    The18th.Areas.TribalCRM.TribalDTOs.MembershipDto myMembership = new The18th.Areas.TribalCRM.TribalDTOs.MembershipDto();
    myMembership.MembershipNumber = currentMemberNumber;

    //Evaluation
    var ourMembership = The18th.Areas.TribalCRM.Data.TribalEvaluationManager.GetEvaluationMembership(currentMemberNumber);

    //Evaluation
    var memberOrders = The18th.Areas.TribalCRM.Data.TribalEvaluationManager.GetEvaluationMyOrders(currentMemberNumber);

    var memberPayments = The18th.Areas.TribalCRM.Data.TribalEvaluationManager.GetEvaluationMyPayments(currentMemberNumber);

    //var memberDeliveries = The18th.Areas.TribalCRM.Data.TribalEvaluationManager.GetEvaluationMyDeliveries(growerNumber);

    ///////////////////////////Favorite Count

    //Evaluation
    var myFavorites = The18th.Areas.TribalCRM.Data.TribalEvaluationManager.GetEvaluationAllMyFavoritesByList(currentMemberNumber);


    if (myFavorites.Count == 0)
    {

        The18th.Areas.TribalCRM.TribalDTOs.MemberFavoritesDto myfavs = new The18th.Areas.TribalCRM.TribalDTOs.MemberFavoritesDto();
        myfavs.MyFavorites = 0;


        List<The18th.Areas.TribalCRM.TribalDTOs.MemberFavoritesDto> noActivityList = new List<The18th.Areas.TribalCRM.TribalDTOs.MemberFavoritesDto>();
        noActivityList.Add(myfavs);

        //return;

    }


}

