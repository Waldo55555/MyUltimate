<link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">
<link href="/CustomStyles.css" rel="stylesheet">
<link href="/BackgroundStyles.css" rel="stylesheet">

<Center>
    <p>Check for growers by state.</p>
</Center>

<div class="container">
    <div class="row">
        <div class="img-responsive">
            <Center><h2>@currentLocation Growers</h2></Center>
            <ul>
                @foreach (var item in myList)
                {
                    <center>
                    <li class="last">
                        &nbsp;&nbsp;&nbsp;<img src="@Url.Content(item.CountyImage)" class="img-responsive" height="250" width="250" />@*col-md-4 col-md-offset-4 img-responsive*@
                        <p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<strong>County:</strong> @item.CountyName</p>
                        <p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<strong>State:</strong> @item.State</p>
                    </li>
                    </center>
                }
            </ul>
            <br /><br /><br />
            &nbsp;&nbsp;&nbsp;<center><a class="btn btn-lg btn-primary" href="State">Back To Search &raquo;</a></center>
        </div>
    </div>
</div>
