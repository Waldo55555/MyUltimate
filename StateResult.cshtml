
@{
    ViewBag.Title = "StateResult";
    Layout = "~/Areas/Growers/Views/Shared/_GrowerMarketLayoutPage.cshtml";

    var myQuery = new List<The18th.Areas.Directory.DirectoryDTOs.CountyLookUpDto>();

    string currentLocation = Request.QueryString["location"].ToString();

    if (currentLocation == "Mississippi")
    {

        var pulled = The18th.Areas.Directory.Data.DirectoryManager.GetMississippi();

        foreach (var item in pulled)
        {

            The18th.Areas.Directory.DirectoryDTOs.CountyLookUpDto pulledCounty = new The18th.Areas.Directory.DirectoryDTOs.CountyLookUpDto();
            pulledCounty.CountyLookUpID = item.CountyLookUpID;
            pulledCounty.CountyName = item.CountyName;
            pulledCounty.County = item.County;
            pulledCounty.State = item.State;
            pulledCounty.CountyImage = item.CountyImage;

            myQuery.Add(pulledCounty);
        }


    }


