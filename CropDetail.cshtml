
@{
    ViewBag.Title = "CropDetail";
    Layout = "~/Areas/Growers/Views/Shared/_GrowerMarketLayoutPage.cshtml";

    string cropIndex = Request.QueryString["cropIndex"];

    var myCropNumber = cropIndex.Trim();
      
    HttpCookie myCookie = Request.Cookies["GrowerCookie"];
    var currentGrowerNumber = myCookie["growerNumber"];

    The18th.Areas.Growers.GrowersDTOs.GrowerCropDto myDeets = new The18th.Areas.Growers.GrowersDTOs.GrowerCropDto();
    myDeets.GrowerNumber = currentGrowerNumber;
    myDeets.CropIndex = myCropNumber;

    var details = The18th.Areas.Segway.Data.SegwayManager.GetSelectedCropInfo(myDeets.CropIndex);


}


@*<h2>CropDetail</h2>*@


<link href="~/bootstrap/css/bootstrap.min.css" rel="stylesheet">
<link href="~/CustomStyles.css" rel="stylesheet">
<link href="~/Navigation.css" rel="stylesheet">

<Center><h2>Crop Detail</h2></Center>

<br />
<br />
<br />

<Center> <img src="~/images/infoPic.png" class="center-block img-responsive" width="100" height="100" alt="photo not found" /></Center>

@foreach (var item in details)
{

    <div class="container">

        <div class="row">

            <div class="col-xs-12">

                <br />
                <center><button class="btn btn-primary btn-lg" data-target="#SignInModal" data-toggle="modal">View Crop Detail</button></center>

                <div class="modal fade" data-keyboard="false" data-backdrop="static" id="SignInModal" tabindex="-1">


                    <div class="modal-dialog">
                        <!--for small form use<div class="modal-dialog-sm"> and for large use <div class="modal-dialog-lg"> -->

                        <div class="modal-content">

                            <div class="modal-header">

                                <h4 class="modal-title">Crop Detail</h4>
                                <button class="close" data-dismiss="modal">&times;</button>
                            </div>


                            <div class="modal-body">

                                <form>

                                    <div class="form-group">
                                        <center><img src="@item.CropImage" class="center-block img-responsive" /></center>
                                        @*<center><img src="data:Image/jpg;base64,@(Html.Raw(Convert.ToBase64String(item.PhotoData)))" width="225" height="100" alt="crop photo" /></center>*@
                                    </div>
                                    @*<div class="form-group">
                                            <label for="inputUserName">Size:&nbsp;@item.Size</label>
                                        </div>*@
                                    <div class="form-group">
                                        <label for="inputUserName">Description:&nbsp;@item.CropDescription</label>
                                    </div>

                                    <div class="form-group">
                                        <label for="inputUserName">Price:&nbsp;@item.Price</label>
                                    </div>
                                    @*<div class="form-group">
                                            <label for="inputUserName">Product Status:&nbsp;@item.CropStatus</label>
                                        </div>*@

                                </form>

                            </div>

                            <div class="modal-footer">

                                @*<button class="btn btn-primary">Start Order</button>*@
                                <button class="btn btn-primary" data-dismiss="modal">Close</button>
                            </div>


                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
    <!-- ####################################################################################################### -->

    <br />

    <center><p><a class="btn btn-lg btn-primary" href="/Growers/Market/CropGroup">Return &raquo;</a></p></center>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.10.2/jquery.min.js"></script>
    <script src="../bootstrap/js/bootstrap.min.js"></script>

}

