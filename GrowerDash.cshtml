                        <center><p>College Activity</p></center>
                        <center><p>HBCU Pledges&nbsp;<span class="label label-danger">Needs Work</span></p></center>
                    </div>*@
                <div class="col-lg-3 col-xs-12">
                    <center><img src="/Images/torp.png" alt="Picture" /></center><br />
                    <center><p><strong>Grow Activity</strong></p></center>
                    <center><p>Enviro Set-Up&nbsp;<span class="label label-danger">Needs Work</span></p></center>
                </div>
                <div class="col-lg-3 col-lg-offset-1 col-xs-12">
                    <center><img src="/Images/busfam.png" alt="Picture" /></center><br />
                    <center><p><strong>Business Activity</strong></p></center>
                    <center><p>M2M Spending&nbsp;<span class="label label-warning">20%</span></p></center>
                </div>
                <div class="col-lg-3 col-lg-offset-1 col-xs-12">
                    <center><img src="/Images/bankfam.png" alt="Picture" /></center><br />
