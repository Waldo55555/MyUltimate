@model The18th.Areas.Account.AccountDTOs.MemberSignUpDto

@{
    ViewBag.Title = "MemberSignUp";
    Layout = "~/Areas/Account/Views/Shared/_AnonymousMemberLayoutPage.cshtml";
}

<!--@*client side validation in order*@-->
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>


<script src="https://js.hcaptcha.com/1/api.js" async defer></script>


<h2>Member Sign-Up</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @*<h4>MemberSignUpDto</h4>*@
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @*<div class="form-group">
                @Html.LabelFor(model => model.MemberSignUpID, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.MemberSignUpID, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.MemberSignUpID, "", new { @class = "text-danger" })
                </div>
            </div>*@

        <div class="form-group">
            @Html.LabelFor(model => model.InvitationNumber, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.InvitationNumber, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.InvitationNumber, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">

                <div class="h-captcha" data-sitekey="a14043b2-3be8-4aa9-beee-30b4069accbc"></div>

                <input type="submit" value="Log-In" class="btn btn-md btn-primary" /> &nbsp; <a class="btn btn-md btn-primary" href="~/Default.aspx">Return</a>
            </div>
