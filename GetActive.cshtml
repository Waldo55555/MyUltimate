                        <p class="title"><img src="/images/torp3.png" height="50" width="110" alt="torppic" />&nbsp;TorpedoPot:&nbsp;&nbsp;<a class="btn btn-xs btn-primary" href="https://torpedopot.com/?ref=iopoislw" target="_blank">Order&raquo;</a></p>

                    </td>
                </tr>

            }
