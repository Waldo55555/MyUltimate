
@{
    ViewBag.Title = "Page2";
    Layout = "~/Areas/Growers/Views/Shared/_GrowerMarketLayoutPage.cshtml";

    var growers = The18th.Areas.Directory.Data.DirectoryManager.GetPage2();

}

<div class="clear"></div>

&nbsp;&nbsp;&nbsp;

<Center><h2>Browse All Growers</h2></Center>
<br />

<Center><p>Top Performing Growers.</p></Center>
<br />
@*<Center><p>The following is a list of all businesses associated with Onyx directory.</p></Center>

    <Center>Support the businesses that support your community. Find businesses near you or those that ship to you!</Center>*@

<div class="table-responsive">
    <table class="table table-hover table-condensed table-striped" CellPadding="0" CellSpacing="0" border="0">
        @*<table class="myTable">*@
        <tr>
            <th>
                @*<strong>Business Photo:</strong>*@
                <strong>&nbsp;</strong>
            </th>
            <th>
                <strong>Growers Name:</strong>
            </th>
            <th>
                <strong>Location:</strong>
            </th>
            <th>
                <strong>Phone:</strong>
            </th>

            <th></th>
        </tr>

        @foreach (var item in growers)
        {
            <tr>
                <td CellPadding="0" CellSpacing="0" border="0">
                  <img src="@item.GrowerImage" width="225" height="100" alt="business photo" />
                </td>
                <td>
                    @item.GrowerName
                </td>
                <td>
                    @item.Location
                </td>
                <td>
                    @item.GrowerPhone
                </td>

                <td>
                  
                    <Center><p><a class="btn btn-lg btn-primary" href="@item.WebAddress">Visit &raquo;</a></p></Center>

                </td>
            </tr>
        }

    </table>

    <!-- ####################################################################################################### -->
    <div class="pagination">
        <ul>
            <li><a href="/AllBusinesses">&laquo; Previous</a></li>
            <li class="prev"><a href="/Page1">1</a></li>
            <li class="current"><a href="/Page2">2</a></li>
            @*<li><a href="/Page2">2</a></li>*@
            @*<li class="splitter">&hellip;</li>
                <li><a href="#">6</a></li>
                <li class="current">7</li>
                <li><a href="#">8</a></li>
                <li><a href="#">9</a></li>
                <li class="splitter">&hellip;</li>
                <li><a href="#">14</a></li>
                <li><a href="#">15</a></li>*@
            <!--<li class="next"><a href="#">Next &raquo;</a></li>-->
        </ul>
    </div>
    <!-- ####################################################################################################### -->
    <br /><br /><br /><br /><br /><br /><br /><br />
    <br /><br /><br /><br /><br />

</div>
