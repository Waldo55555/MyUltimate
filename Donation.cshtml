<body>
    <div class="navbar navbar-default navbar-static-top">
        <div class="container">
            @*<a href="/MarketPlace/Market/AllVendors?memberAccountNumber=@memberAccountNumber + &vendorNumber= + @vendorNumber" class="navbar-brand">One Farm(beta)</a>*@
            <a href="Default.aspx" class="navbar-brand">One State(beta)</a>
