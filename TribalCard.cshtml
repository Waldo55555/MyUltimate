@model The18th.Areas.TribalCRM.TribalDTOs.TribalCardDto

@{
    ViewBag.Title = "TribalCard";
    Layout = "~/Areas/TribalCRM/Views/Shared/_TribalLayoutPage.cshtml";

    HttpCookie currentMemberCookie = Request.Cookies["MemberCookie"];
    var currentMemberNumber = currentMemberCookie["membershipNumber"];

}

<link href="~/bootstrap/css/bootstrap.min.css" rel="stylesheet">
<link href="~/CustomStyles.css" rel="stylesheet">
