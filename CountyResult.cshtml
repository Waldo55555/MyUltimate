@model IEnumerable<The18th.Areas.Growers.GrowersDTOs.GrowerPageDto>

@{
    ViewBag.Title = "CountyResult";
    Layout = "~/Areas/Growers/Views/Shared/_GrowerMarketLayoutPage.cshtml";
      
    string currentLocation = Request.QueryString["location"].ToString();

    The18th.Areas.Growers.GrowersDTOs.GrowerPageDto mySearch = new The18th.Areas.Growers.GrowersDTOs.GrowerPageDto();
    mySearch.County = currentLocation;
    if (mySearch.County == "Nothing")
    {
        Response.Redirect("SearchNotFound");
    }

    //var pulled = The18th.Areas.Growers.Data.GrowersMarketManager.GetAllGrowerPages();

    var pulled = The18th.Areas.Directory.Data.DirectoryManager.GetAllGrowerPages();


    var newPull = from p in pulled
                  where p.County == currentLocation
                  select p;
    var myList = new List<The18th.Areas.Growers.GrowersDTOs.GrowerPageDto>(newPull);
    if (myList.Count <= 0)
    {
        The18th.Areas.Growers.GrowersDTOs.GrowerPageDto myOtherMessage = new The18th.Areas.Growers.GrowersDTOs.GrowerPageDto();
        myOtherMessage.Message = "No results at this time";
        <Center><h2>@myOtherMessage.Message</h2></Center>
        Response.Redirect("CountyNotFound?location=" + currentLocation);
    }
    try
    {

    }
    catch (System.NullReferenceException ex)
    {
        string message = ex.Message;
        Response.Redirect("~/Errors/SearchNotFoundError.aspx");
    }

}

<link href="../bootstrap/css/bootstrap.min.css" rel="stylesheet">
<link href="../CustomStyles.css" rel="stylesheet">
<link href="../BackgroundStyles.css" rel="stylesheet">


<div class="container">

    <div class="page-header">

        <div class="container">
            <div class="row">
                <div class="img-responsive">
                    <div class="row">
                        <Center><h2>@currentLocation Farms</h2></Center>
                        <div id="portfolio">
                            <ul>
                                @foreach (var item in newPull)
                                {
                                    <li class="last">
                                        &nbsp;&nbsp;&nbsp;<img src="@item.ImageData" class="col-md-4 col-md-offset-4 img-responsive" />
                                        <p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Name: @item.GrowerName</p>
                                        <p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Farm Type: @item.GrowerType</p>
                                        <p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;@item.GrowerDescription</p>
                                        <p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<a href="@item.MarketAddress">Farmers Market</a></p>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                    <center><a class="btn btn-lg btn-outline-dark" href="/County">Back To Search &raquo;</a></center>
                </div>
            </div>
        </div>
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js"></script>
        <script src="bootstrap/js/bootstrap.min.js"></script>
        <br /><br /><br /><br /><br /><br />
        <br /><br /><br /><br /><br /><br />


    </div>


</div>