<link href="../bootstrap/css/bootstrap.min.css" rel="stylesheet" />
<link href="../CustomStyles.css" rel="stylesheet" />
<link href="../BackgroundStyles.css" rel="stylesheet" />

<div class="img-responsive">
    <div class="row">
        <div class="col-lg-12">
            <center><h3>Top News Of The Day</h3></center>
        </div>
        @*<center><video src="~/KnowledgeVideos/Poultry.mp4" controls=controls width="400" height="300"></video></center>*@
        <center><video src="https://the18thstorage.blob.core.windows.net/the18thcontainer/intro.mp4" width="400" height="300" autoplay="autoplay"></video></center>@*autoplay="autoplay", loop="loop", controls=controls*@
        <div id="accordian" class="panel-group">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h4 class="panel-title">
                        <a href="#panelBodyOne" data-toggle="collapse" data-parent="#accordian">
                            <span class="glyphicon glyphicon-menu-up"></span>
                            Black Star Network
                        </a>
                    </h4>
                </div>
                <div id="panelBodyOne" class="panel-collapse collapse">
                    <div class="panel-body">
                        <center><img class="img-responsive" src="https://the18thstorage.blob.core.windows.net/the18thcontainer/Rolandposter.webp" alt="pic" /></center>
                        <ul>
                            @foreach (var item in myBsnList)
                            {
                                <center><p>@item.NewsOutlet</p></center>
                                <p><a href="@item.NewsUrl" target="_blank">@item.NewsTitle</a>&nbsp;<span><em><strong>Pub:</strong></em></span>&nbsp;@item.DateCreated.ToShortDateString()&nbsp;@item.OwnershipNote</p>
                            }
                        </ul>
                    </div>
                </div>

                @*Second*@
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h4 class="panel-title">
                            <a href="#panelBodyTwo" data-toggle="collapse" data-parent="#accordian">
                                <span class="glyphicon glyphicon-menu-up"></span>
                                African Diaspora News Channel
                            </a>
                        </h4>
                    </div>
                    <div id="panelBodyTwo" class="panel-collapse collapse">
                        <div class="panel-body">
                            <center><img class="img-responsive" src="https://the18thstorage.blob.core.windows.net/the18thcontainer/ADNC.jpeg" height="400" width="400" alt="pic" /></center>
